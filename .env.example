# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TLCL_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# Place rules: JSON list of {name, address, lat, lon, radius_m, limit_pct}.
# Limits are clamped to 50-100; radius_m defaults to 150.
# You never need to hand-write this — `tlcl setup` and `tlcl places add`
# geocode addresses for you.
TLCL_PLACES=[{"name":"Home","address":"123 Main St, Palmdale, CA","lat":34.5794,"lon":-118.1185,"radius_m":150,"limit_pct":80}]

# Optional: charge limit applied when a car LEAVES a ruled place.
# Blank = leave the limit alone.
TLCL_DEFAULT_LIMIT_PCT=

# The OpenAI-compatible server THIS app exposes
TLCL_SERVER_HOST=127.0.0.1
TLCL_SERVER_PORT=8643
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TLCL_SERVER_API_KEY=
TLCL_MODEL_ID=tesla-location-charge-limits

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# Point at OpenAI, Groq, LM Studio, llama.cpp, ... or leave Ollama defaults.
# The app works FULLY without a backend (rules engine); the LLM only handles
# free-form questions. Vehicle data is sent only to this backend — nowhere else.
TLCL_AI_BASE_URL=http://localhost:11434/v1
TLCL_AI_API_KEY=
TLCL_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TLCL_AI_MODE=auto
TLCL_AI_TIMEOUT_SECONDS=20

# Enforcement state (exactly-once bookkeeping) — survives between runs
TLCL_STATE_FILE=~/.tlcl/state.json
# Default check cadence in seconds when driven by a scheduler
TLCL_POLL_SECONDS=300
TLCL_TOKEN_FILE=~/.tlcl/tokens.json
# 1 = report commands instead of sending them
TLCL_DRY_RUN=0
